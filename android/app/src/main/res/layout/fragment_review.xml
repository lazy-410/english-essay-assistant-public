<?xml version="1.0" encoding="utf-8"?>
<!-- 批改页：上传/手输 → 校对（题型、题干、真题、AI 开关）→ 开始批改 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_variant"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_pad">

        <com.google.android.material.card.MaterialCardView
            style="@style/Eea.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_3">

                <TextView
                    style="@style/Eea.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rv_section_photo" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="@string/rv_photo_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rv_photo"
                        style="@style/Eea.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:text="@string/write_photo"
                        android:textSize="@dimen/text_label" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rv_gallery"
                        style="@style/Eea.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_weight="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:text="@string/write_gallery"
                        android:textSize="@dimen/text_label" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rv_paste"
                        style="@style/Eea.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_weight="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:text="@string/write_paste_image"
                        android:textSize="@dimen/text_label" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rv_manual"
                        style="@style/Eea.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_weight="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:text="@string/rv_manual_input"
                        android:textSize="@dimen/text_label" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/rv_preview"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="@dimen/space_2"
                    android:contentDescription="@string/rv_section_photo"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/rv_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/rv_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Eea.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_3">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Eea.FieldLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/rv_section_proof" />

                    <TextView
                        android:id="@+id/rv_word_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Eea.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:hint="@string/rv_text_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/rv_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="6" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rv_restore_raw"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rv_restore_raw"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/rv_detection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/rv_exam_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/rv_exam_none"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_label" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rv_pick_exam"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/rv_pick_action"
                        android:textSize="@dimen/text_label" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rv_clear_exam"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:text="@string/rv_pick_clear"
                        android:textSize="@dimen/text_label"
                        android:visibility="gone" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/rv_category_box"
                    style="@style/Eea.TextInput.Exposed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:hint="@string/rv_category_label">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/rv_category"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/rv_question_box"
                    style="@style/Eea.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:hint="@string/rv_question_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/rv_question"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:minLines="2" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Eea.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_3">

                <TextView
                    style="@style/Eea.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rv_section_options" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/rv_ai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="@string/rv_ai_deepen"
                    android:textSize="@dimen/text_label" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/rv_ai_grammar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rv_ai_grammar"
                    android:textSize="@dimen/text_label" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rv_analyze"
            style="@style/Eea.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/rv_analyze" />

        <TextView
            android:id="@+id/rv_busy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center"
            android:text="@string/rv_analyzing"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_label"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
