<?xml version="1.0" encoding="utf-8"?>
<!-- 真题列表项（选择器与题库页共用） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_3"
    android:paddingTop="@dimen/space_2"
    android:paddingEnd="@dimen/space_3"
    android:paddingBottom="@dimen/space_2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/exam_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/exam_essay_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/brand_blue_container"
            android:paddingStart="@dimen/space_1"
            android:paddingTop="2dp"
            android:paddingEnd="@dimen/space_1"
            android:paddingBottom="2dp"
            android:textColor="@color/on_brand_container"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/exam_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption" />
</LinearLayout>
