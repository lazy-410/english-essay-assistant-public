<?xml version="1.0" encoding="utf-8"?>
<!-- 答题卡页：上方实时预览（WebView 岛屿），下方控制项与导出。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_variant"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_4"
        android:paddingTop="@dimen/space_1"
        android:paddingEnd="@dimen/space_1"
        android:paddingBottom="@dimen/space_1">

        <TextView
            android:id="@+id/sheet_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sheet_status_idle"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_pdf"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/sheet_export_pdf" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_png"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/sheet_export_png" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/outline" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6">

        <WebView
            android:id="@+id/sheet_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface_sunken" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/sheet_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sheet_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/space_5"
            android:text="@string/sheet_empty"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <!-- 不可见的光栅化岛屿：PNG 导出走这里的 canvas.toDataURL -->
        <WebView
            android:id="@+id/sheet_raster"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:alpha="0"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:background="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_4">

            <TextView
                style="@style/Eea.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sheet_label_template" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/sheet_template_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                app:singleSelection="true" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/sheet_font_wrap"
                style="@style/Eea.TextInput.Exposed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:hint="@string/sheet_label_font">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/sheet_font"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Eea.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/sheet_label_color" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/sheet_color_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sheet_color_black"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sheet_color_black" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sheet_color_red"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sheet_color_red" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sheet_color_blue"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sheet_color_blue" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sheet_color_darkgray"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sheet_color_darkgray" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                style="@style/Eea.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/sheet_label_style" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/sheet_style_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sheet_style_block"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sheet_style_block" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sheet_style_indent"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sheet_style_indent" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                style="@style/Eea.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/sheet_label_kind" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/sheet_kind_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sheet_kind_letter"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sheet_kind_letter" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sheet_kind_notice"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sheet_kind_notice" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/sheet_size_label"
                style="@style/Eea.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/sheet_label_size" />

            <SeekBar
                android:id="@+id/sheet_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="16" />

            <TextView
                android:id="@+id/sheet_slant_label"
                style="@style/Eea.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/sheet_label_slant" />

            <SeekBar
                android:id="@+id/sheet_slant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="15" />

            <TextView
                android:id="@+id/sheet_baseline_label"
                style="@style/Eea.FieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/sheet_label_baseline" />

            <SeekBar
                android:id="@+id/sheet_baseline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sheet_preset_exam"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sheet_preset_exam" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sheet_preset_copybook"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="@string/sheet_preset_copybook" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/sheet_render"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:text="@string/sheet_render" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/sheet_text_wrap"
                style="@style/Eea.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:hint="@string/sheet_label_essay"
                app:helperText="@string/sheet_essay_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/sheet_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/sheet_salutation_wrap"
                style="@style/Eea.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:hint="@string/sheet_label_salutation">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/sheet_salutation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/sheet_signature_wrap"
                style="@style/Eea.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:hint="@string/sheet_label_signature">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/sheet_signature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/sheet_title_wrap"
                style="@style/Eea.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:hint="@string/sheet_label_title">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/sheet_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/sheet_date_wrap"
                style="@style/Eea.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:hint="@string/sheet_label_date">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/sheet_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
