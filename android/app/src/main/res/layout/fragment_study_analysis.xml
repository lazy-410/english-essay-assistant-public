<?xml version="1.0" encoding="utf-8"?>
<!-- 行文解析：选一道真题 → 逐段讲解（可叠加 AI 深化）→ 导出精讲 PDF -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_pad">

        <com.google.android.material.card.MaterialCardView
            style="@style/Eea.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_3">

                <TextView
                    android:id="@+id/sa_exam"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/sa_none"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sa_pick"
                        style="@style/Eea.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sa_pick" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sa_pdf"
                        style="@style/Eea.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_2"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="@string/sa_pdf" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sa_ai"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:checked="true"
                    android:text="@string/sa_ai"
                    android:textSize="@dimen/text_label" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/sa_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Eea.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3">

            <TextView
                android:id="@+id/sa_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:padding="@dimen/space_3"
                android:text="@string/sa_hint"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
