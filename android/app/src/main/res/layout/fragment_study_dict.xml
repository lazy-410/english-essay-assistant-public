<?xml version="1.0" encoding="utf-8"?>
<!-- 模板字典：讲义词表检索 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_pad">

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Eea.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/sd_search_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/sd_keyword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sd_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sd_search"
            style="@style/Eea.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ex_search" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        style="@style/Eea.Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_2"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sd_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="@dimen/space_1"
            android:paddingBottom="@dimen/space_1"
            android:clipToPadding="false" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
