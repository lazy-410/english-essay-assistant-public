<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 亮色主题 + 品牌蓝。本期不做深色模式。 -->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Eea" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/brand_blue_container</item>
        <item name="colorOnPrimaryContainer">@color/on_brand_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="colorSurfaceVariant">@color/surface_sunken</item>
        <item name="android:colorBackground">@color/surface_variant</item>
        <item name="colorError">@color/danger</item>
        <item name="android:statusBarColor">@color/brand_blue_dark</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="materialButtonStyle">@style/Eea.Button</item>
    </style>

    <!-- 主按钮：整宽、常规高度、圆角。 -->
    <style name="Eea.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="cornerRadius">@dimen/control_radius</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Eea.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="cornerRadius">@dimen/control_radius</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Eea.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/control_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/control_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/control_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/control_radius</item>
    </style>

    <!-- 下拉选择（MaterialAutoCompleteTextView）用：带尾部箭头 -->
    <style name="Eea.TextInput.Exposed" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/control_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/control_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/control_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/control_radius</item>
    </style>

    <!-- 分组标题（如下拉项上方的小字标签） -->
    <style name="Eea.FieldLabel" parent="">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Eea.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>
</resources>
